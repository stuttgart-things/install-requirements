#!/usr/bin/env bash
shopt -s extglob   # +([0-9;]) when measuring coloured rows
# sthings-motd -- login banner: the stuttgart-things mascot in a colour
# gradient, next to what this machine is and what needs attention.
# No sudo, no network (except dev-status's cached GitHub check).
#
# Colours: a random theme per call. STHINGS_MOTD_THEME=<name> pins one,
# `sthings-motd --themes` lists them, NO_COLOR=1 switches colour off.

# name  r1 g1 b1  r2 g2 b2   (gradient start -> end)
# No red themes (the former "sunset" and "fire"): red is the signal colour of
# this banner -- ✗ checks, disks from 90 % -- and does not suit the mascot.
THEMES=(
  "ocean      0 198 255     0 114 255"
  "aurora     0 242  96     5 117 230"
  "purple   168  85 247   236  72 153"
  "mint      67 233 123    56 249 215"
  "candy    252  92 125   106 130 251"
  "gold     247 151  30   255 210   0"
  "ice      142 197 252   224 195 252"
  "forest    90 160  80   200 230 110"
)

ART=(
"                               @@@@@"
"                              ./@ . @. %#"
"               %%% %% ...%%%%.@@ @@@..(%%% ..."
"              %%%%%%%%%...%%% . @@@.. %%%... %%(%%%%"
"              %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
"            .. %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% ."
"          .... %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% ...."
"         %%%%% %%%%%%%(  .  *%%%%%  @@@ %%%%%%%%(%%%%%"
"       %%%%%%%%%%%%%        @@%% @     @@@.%%%%%%%%%%%%"
"      ....... %%%%% @        @ %,       @@ %%%%%%%%%%%%%"
"     ........ %%%%% @.   @@  @ %@   @   @@ %%%%% ........"
"    ........./%%%%% @@@    @@@ %@@     @@@ %%%%% ........."
"   %%%%%%%%%%,%%%%%% @@@@@@@@@%%%@@@@@@@@ %%%%%% .,*(%%%%%%"
"  %%%%%%%%%%%  %%%%%%%%%%#%%     %%%%%%%%%%%%%%% %%%%%%%%%%"
" %%%%%%%%%%%     %%%%%%% %%%%%  %%%%% %%%%%%%%   %%%%%%%%%%%"
"    ........        %%%%%%%%%%%%%%%%%%%%%%#      ........."
"      ......   %%%%#     %%%%%%%%%%,  %%%        ....."
"         ...       %%%%%%%%%%%%%%%%%%%%%%%        ..."
"                  %%%%%%%%%%%%%%%%%%%%%%%%.%%"
"                %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
"                %%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
"                   %%% %%%%% %%%%/ %%%%% %"
"                     %%%%%%%%% % %%%%%%%%"
)
WORDMARK=(
"█▀ ▀█▀ █░█ ▀█▀ ▀█▀ █▀▀ ▄▀█ █▀█ ▀█▀ ▄▄ ▀█▀ █░█ █ █▄░█ █▀▀ █▀"
"▄█ ░█░ █▄█ ░█░ ░█░ █▄█ █▀█ █▀▄ ░█░ ░░ ░█░ █▀█ █ █░▀█ █▄█ ▄█"
)
ART_W=62

if [ "${1:-}" = "--themes" ]; then
  for t in "${THEMES[@]}"; do
    read -r name r1 g1 b1 r2 g2 b2 <<<"$t"
    printf '\033[38;2;%s;%s;%sm████\033[38;2;%s;%s;%sm████\033[0m %s\n' "$r1" "$g1" "$b1" "$r2" "$g2" "$b2" "$name"
  done
  exit 0
fi

# ---------------------------------------------------------------- versions
# Asking every tool for its version takes ~3 s (k9s, terraform, crossplane,
# kcl ~0.4 s each), far too slow for a banner. So the banner only READS a
# cache; `--refresh-versions` writes it, started in the background when the
# cache is older than an hour. The very first terminal shows no versions yet.
# Category -> tools, in display order. Only what is installed is shown, so
# the list can be long. Add a tool here; give it VARGS below unless
# `<tool> --version` is its version call.
CATS=(
  "LANG  python3 go node npm pip3 uv"
  "CNTR  docker podman nerdctl buildctl skopeo dagger"
  "K8S   kubectl helm helmfile kind k9s kustomize kubectl-slice kubeconform stern cilium vcluster argocd flux crossplane xpdig tkn velero"
  "IAC   terraform tofu packer ansible ansible-lint kcl govc machineshop"
  "SEC   sops age vault vals cosign trivy"
  "TOOLS git gh glab task chezmoi pre-commit semantic-release goreleaser ko golangci-lint gum jq yq mc hugo vhs claude"
  "SHELL tmux starship fzf zoxide atuin"
)
# Non-default version calls. CLIENT-ONLY wherever plain `version` would
# contact a cluster or server (kubectl, cilium, argocd, velero, tkn, flux,
# crossplane, docker's `version`).
declare -A VARGS=(
  [go]="version" [kubectl]="version --client" [helm]="version --short"
  [kind]="version" [k9s]="version --short" [kustomize]="version"
  [kubeconform]="-v" [cilium]="version --client" [argocd]="version --client --short"
  [flux]="version --client" [crossplane]="version --client" [xpdig]="version"
  [tkn]="version --component client" [velero]="version --client-only"
  [terraform]="version" [packer]="version" [govc]="version" [machineshop]="version"
  [vault]="version" [vals]="version" [cosign]="version" [dagger]="version"
  [ko]="version" [hugo]="version" [tmux]="-V"
)
VCACHE="${XDG_CACHE_HOME:-$HOME/.cache}/sthings-motd/versions"
if [ "${1:-}" = "--refresh-versions" ]; then
  # The PATH of the user's login shell, not this background job's: nvm's
  # default node (else /usr/bin/node from the apt package wins -- dev5 showed
  # node 22 / npm 9 while the shell runs 24 / 11) and ~/ansible-venv (else
  # ansible is missing from the list). Those go FIRST, as in the shell.
  nvm_bin=""
  if [ -r "$HOME/.nvm/alias/default" ]; then
    read -r nvm_def <"$HOME/.nvm/alias/default"
    for d in "$HOME/.nvm/versions/node/v${nvm_def#v}"*; do [ -x "$d/bin/node" ] && nvm_bin="$d/bin"; done
  fi
  export CHECKPOINT_DISABLE=1 PATH="${nvm_bin:+$nvm_bin:}${HOME}/ansible-venv/bin:$PATH:/usr/local/go/bin:$HOME/.local/bin"
  mkdir -p "${VCACHE%/*}"
  lock="${VCACHE%/*}/.lock"
  mkdir "$lock" 2>/dev/null || exit 0
  trap 'rmdir "$lock"' EXIT
  tmp=$(mktemp "${VCACHE}.XXXX"); work=$(mktemp -d)
  # All probes in parallel (one slow start each adds up to ~20 s in series),
  # then assembled in CATS order.
  n_=0
  for cat in "${CATS[@]}"; do
    read -r ckey tools <<<"$cat"
    for tool in $tools; do
      n_=$((n_ + 1))
      command -v "$tool" >/dev/null 2>&1 || continue
      read -r -a args <<<"${VARGS[$tool]:---version}"
      # a probe that fails this time (timeout, a lock held by a running
      # chezmoi, ...) keeps the version from the last refresh
      ( v=$(timeout 15 "$tool" "${args[@]}" </dev/null 2>&1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
        [ -n "$v" ] || v=$(awk -v t="${tool%3}" '$2 == t { print $3; exit }' "$VCACHE" 2>/dev/null)
        [ -n "$v" ] && printf '%s %s %s\n' "$ckey" "${tool%3}" "$v" >"$work/$(printf '%03d' "$n_")" ) &
    done
  done
  wait
  cat "$work"/* >"$tmp" 2>/dev/null
  rm -rf "$work"
  mv "$tmp" "$VCACHE"
  exit 0
fi
if [ -z "$(find "$VCACHE" -mmin -60 2>/dev/null)" ]; then
  (setsid "$0" --refresh-versions </dev/null >/dev/null 2>&1 &)
fi

theme=""
for t in "${THEMES[@]}"; do [ "${t%% *}" = "${STHINGS_MOTD_THEME:-}" ] && theme=$t; done
[ -z "$theme" ] && theme=${THEMES[RANDOM % ${#THEMES[@]}]}
read -r _ r1 g1 b1 r2 g2 b2 <<<"$theme"

truecolor=0
case "${COLORTERM:-}" in truecolor|24bit) truecolor=1 ;; esac
case "${TERM_PROGRAM:-}" in vscode|iTerm.app|WezTerm|ghostty) truecolor=1 ;; esac

# fg VAR r g b -> escape into VAR (printf -v, no subshell per character)
fg() {
  if [ -n "${NO_COLOR:-}" ]; then printf -v "$1" ''; return; fi
  if [ "$truecolor" = 1 ]; then
    printf -v "$1" '\033[38;2;%d;%d;%dm' "$2" "$3" "$4"
  else
    printf -v "$1" '\033[38;5;%dm' $((16 + 36 * ($2 * 5 / 255) + 6 * ($3 * 5 / 255) + ($4 * 5 / 255)))
  fi
}
# grad VAR text row rows -> text in a diagonal gradient (top-left -> bottom-right)
grad() {
  local -n _out=$1; local text=$2 row=$3 rows=$4 i ch c t len=${#2} last=-1
  _out=""
  for ((i = 0; i < len; i++)); do
    ch=${text:i:1}
    if [ "$ch" = " " ]; then _out+=" "; continue; fi
    t=$(( (i * 1000 / ART_W + row * 1000 / rows) / 2 ))
    if [ $((t / 25)) != "$last" ]; then
      last=$((t / 25))
      fg c $((r1 + (r2 - r1) * t / 1000)) $((g1 + (g2 - g1) * t / 1000)) $((b1 + (b2 - b1) * t / 1000))
      _out+=$c
    fi
    _out+=$ch
  done
}

if [ -n "${NO_COLOR:-}" ]; then n="" dim="" YL="" C="" G=""; else
  n=$'\033[0m'; dim=$'\033[2m'
  YL=$'\033[1;33m'; C=$'\033[1;31m'; G=$'\033[1;32m'
fi
acc="" acc2=""
fg acc "$r1" "$g1" "$b1"
fg acc2 "$r2" "$g2" "$b2"

# ---------------------------------------------------------------- facts
fqdn=$(hostname -f 2>/dev/null || hostname)
case "$fqdn" in
  *.labul.sva.de) lab=LabUL ;;
  *.labda.sva.de) lab=LabDA ;;
  *) lab=${fqdn#*.} ;;
esac
virt=$(systemd-detect-virt 2>/dev/null)
case "$virt" in vmware) hv=vSphere ;; kvm|qemu) hv=Proxmox ;; none) hv=bare-metal ;; *) hv=$virt ;; esac
product=$(cat /sys/class/dmi/id/product_name 2>/dev/null)
hvx=$hv
# BUILT: the build marker sthings.baseos.setup writes from the order
# (/etc/sthings/build.yaml: source, order, use case, lab, management cluster,
# date). Without one, a Crossplane-built Proxmox VM still says so through the
# SMBIOS product its composition sets.
b_how=""; b_mgmt=""
if [ -r /etc/sthings/build.yaml ]; then
  declare -A bm=()
  while IFS=': ' read -r bk bv; do
    case "$bk" in ''|\#*) ;; *) bm[$bk]=$bv ;; esac
  done </etc/sthings/build.yaml
  # BUILD via <method>; markers from before the method field: their source
  bmeth=${bm[method]:-${bm[source]:-unknown}}
  case "$bmeth" in terraform-dagger) bmeth="terraform (dagger)" ;; esac
  b_how="via ${bmeth}"
  case "${bm[management_lab]:-}" in labda) ml=LabDA ;; labul) ml=LabUL ;; *) ml=${bm[management_lab]:-} ;; esac
  b_mgmt="${bm[management_cluster]:-}"
  inner="${ml}${ml:+${bm[built]:+, }}${bm[built]:-}"
  [ -n "$inner" ] && b_mgmt+=" (${inner})"
fi
case "$product" in crossplane-*) [ -z "$b_how" ] && { b_how="via ${product}"; b_mgmt="(no build marker)"; } ;; esac
ip=$(hostname -I 2>/dev/null | cut -d' ' -f1)
# shellcheck disable=SC1091
. /etc/os-release 2>/dev/null
# Installed memory: online memory blocks in sysfs (16 GiB), not MemTotal
# (15.1 GiB: what is left after the kernel's reservations). MemTotal rounded
# where sysfs has no memory blocks.
mem=""
if read -r mbs 2>/dev/null </sys/devices/system/memory/block_size_bytes; then
  nb=0
  for f in /sys/devices/system/memory/memory*/state; do read -r ms <"$f" && [ "$ms" = online ] && nb=$((nb + 1)); done
  [ $nb -gt 0 ] && mem=$(( nb * 0x$mbs / 1073741824 ))
fi
[ -n "$mem" ] || mem=$(awk '/MemTotal/{printf "%.0f", $2/1048576}' /proc/meminfo)
up=$(uptime -p | sed 's/^up //; s/, [0-9]* minutes\?$//; s/ weeks\?/w/; s/ days\?/d/; s/ hours\?/h/; s/ minutes\?/m/; s/,//g')
read -r load1 _ < /proc/loadavg
kver=$(uname -r); kver=${kver%-*}
cpus=$(nproc)
osn=${PRETTY_NAME:-linux}

# ---------------------------------------------------------------- width
# $COLUMNS when the caller sets it (`COLUMNS=120 sthings-motd`; bash does not
# export it on its own), else the terminal itself -- in $(...) tput sees a
# pipe and says 80.
cols=${COLUMNS:-}
[ -n "$cols" ] || cols=$( { stty size </dev/tty; } 2>/dev/null | cut -d' ' -f2)
[ -n "$cols" ] || cols=80
# Everything is laid out within TOTAL columns: min(terminal, 160). Each row
# starts with one space, so content gets TOTAL - 1.
TOTAL=$(( cols < 160 ? cols : 160 ))

# ---------------------------------------------------------------- text helpers
# Every row is built from segments whose visible width is counted as they are
# added -- never measured afterwards by stripping escapes (that pattern
# substitution cost ~1.5 s). Widths are characters, not bytes (bash's printf
# pads by bytes: "kümmer" came out one short). Two columns: 4-byte UTF-8
# characters (emoji) and U+3000-U+D7FF (CJK, kana, hangul: lead bytes E3-ED);
# none: the emoji variation selector U+FE0F and the zero-width joiner.
vw() {
  local s=$1 c=${#1}; local LC_ALL=C
  local t=${s//[^$'\xf0'-$'\xf4'$'\xe3'-$'\xed']/} z=${s//$'\xef\xb8\x8f'/}
  z=${z//$'\xe2\x80\x8d'/}
  VW=$(( c + ${#t} - (${#s} - ${#z}) / 3 ))
}
# fit TEXT MAX -> FIT: TEXT, or cut to MAX columns at a word boundary + "…"
fit() {
  local s=$1 m=$2 w
  vw "$s"; if [ "$VW" -le "$m" ]; then FIT=$s; return; fi
  if [ "$m" -le 1 ]; then FIT="…"; return; fi
  s=${s:0:m-1}; vw "$s"
  while [ "$VW" -gt $((m - 1)) ]; do s=${s:0:${#s}-1}; vw "$s"; done
  w=${s% *}; [ "$w" != "$s" ] && [ ${#w} -ge $((m * 6 / 10)) ] && s=$w
  s=${s%%+([ ,.;:·/-])}
  FIT="${s}…"
}
# the row being built: R (with colour) and RW (visible width)
R=""; RW=0
seg() { R+="${1}${2}${1:+$n}"; vw "$2"; RW=$((RW + VW)); }   # COLOUR TEXT
sp() { [ "$1" -gt 0 ] || return 0; printf -v _s '%*s' "$1" ''; R+=$_s; RW=$((RW + $1)); }
padto() { sp $(( $1 - RW )); }
key() { [ -n "$1" ] && seg "$acc" "${1^^}"; padto "$2"; }
# rows of the current build: ROWS / ROWW; blocks: start, length, blank before
emit() { ROWS+=("$R"); ROWW+=("$RW"); R=""; RW=0; }
KW=8   # key column of the blocks (facts in one column use 11)

# seconds -> 1d14h / 5h21m / 13m
dur() {
  local t=$1
  if [ "$t" -ge 86400 ]; then DUR="$((t / 86400))d$((t % 86400 / 3600))h"
  elif [ "$t" -ge 3600 ]; then DUR="$((t / 3600))h$((t % 3600 / 60))m"
  else DUR="$((t / 60))m"; fi
}

# ---------------------------------------------------------------- data
# Facts in pairs (FQDN|IP, LAB|HYPERVISOR, ...), or one column when narrow.
L_K=(fqdn lab os host);  L_V=("$fqdn" "$lab" "$osn" "${cpus} CPU · ${mem} GiB")
R_K=(ip hypervisor kernel uptime); R_V=("$ip" "$hvx" "$kver" "$up")
if [ -n "$b_how" ]; then L_K+=(build); L_V+=("$b_how"); R_K+=(management); R_V+=("$b_mgmt"); fi
lw=0; for v in "${L_V[@]}"; do vw "$v"; [ "$VW" -gt "$lw" ] && lw=$VW; done
rvw=0; for v in "${R_V[@]}"; do vw "$v"; [ "$VW" -gt "$rvw" ] && rvw=$VW; done
pair_w=$(( KW + lw + 4 + 12 + rvw ))

# CHECK (dev VMs: gh / git / sops / kube)
CHK=()
if command -v dev-status >/dev/null 2>&1; then
  while IFS= read -r l; do CHK+=("$l"); done < <(dev-status --raw 2>/dev/null)
fi

# SYSTEM: CPU (load / cores), memory, swap when there is any, the partitions
read -r load1 _ < /proc/loadavg
l100=${load1/./}; l100=$((10#$l100)); cpu_p=$(( l100 / cpus )); [ $cpu_p -gt 100 ] && cpu_p=100
while read -r mk mv _; do
  case "$mk" in MemTotal:) mt=$mv ;; MemAvailable:) ma=$mv ;; SwapTotal:) st_=$mv ;; SwapFree:) sf=$mv ;; esac
done </proc/meminfo
mu=$(( mt - ma )); mem_p=$(( mu * 100 / mt ))
gib() { printf -v GIB '%d.%dG' $(( $1 / 1048576 )) $(( $1 * 10 / 1048576 % 10 )); }
gib "$mu"; mu_s=$GIB; gib "$mt"; mt_s=$GIB
G_L=(CPU MEM); G_P=("$cpu_p" "$mem_p")
G_T=("load ${load1} / ${cpus} cores" "${mu_s} / ${mt_s} usable")
if [ "${st_:-0}" -gt 0 ]; then
  su=$(( st_ - sf )); gib "$su"; su_s=$GIB; gib "$st_"
  G_L+=(SWAP); G_P+=("$(( su * 100 / st_ ))"); G_T+=("${su_s} / ${GIB}")
fi
while read -r target size used pcent; do
  G_L+=("$target"); G_P+=("${pcent%\%}"); G_T+=("${used} / ${size}")
done < <(df -h --output=target,size,used,pcent / /home /var 2>/dev/null | tail -n +2 | awk '!seen[$1]++')

# STATUS: reboot, failed units, updates -- a quiet grey line when all is well
reboot=0; [ -f /var/run/reboot-required ] && reboot=1
failed=$(systemctl --failed --no-legend 2>/dev/null | wc -l)
upd=0
if [ -r /var/lib/update-notifier/updates-available ]; then
  while read -r a b _; do [ "$b" = updates ] && { upd=$a; break; }; done </var/lib/update-notifier/updates-available
fi

# Sessions from claude-sessions --json (dotfiles): the one source the global
# tasks use too. tmux session = a live workplace; Claude session = a
# conversation that MAY run in a tmux pane (claude-sessions decides that).
# Without claude-sessions (a VM without the dotfiles) only `tmux ls`.
# The banner runs from ~/.bashrc BEFORE ~/.local/bin is on the PATH, so look
# there explicitly.
T_N=(); declare -A T_W=() T_A=() T_P=() T_KNOWN=()
C_ID=(); C_CWD=(); C_AGE=(); C_ST=(); C_TMUX=(); C_WH=(); C_TI=(); C_OR=(); C_RUN=()
CS=$(command -v claude-sessions 2>/dev/null || true)
[ -z "$CS" ] && [ -x "$HOME/.local/bin/claude-sessions" ] && CS="$HOME/.local/bin/claude-sessions"
if [ -n "$CS" ] && command -v jq >/dev/null 2>&1; then
  while IFS=$'\t' read -r k a b c d e f g h i; do
    if [ "$k" = T ]; then
      T_N+=("$a"); T_W[$a]=$b; T_A[$a]=$c; T_P[$a]=$d; T_KNOWN[$a]=1
    else
      C_ID+=("$a"); C_CWD+=("$b"); C_AGE+=("$c"); C_ST+=("$d"); C_TMUX+=("$e"); C_WH+=("$f")
      [ "$g" = "-" ] && g=""
      C_TI+=("$g"); C_OR+=("$h"); C_RUN+=("$i")
    fi
  done < <("$CS" --json 15 2>/dev/null | jq -r '
      (.tmux[] | ["T", .name, (.windows|tostring), (.attached|tostring), .path, "", "", "", "", ""]),
      (.sessions[] | ["S", .id, .cwd, .age, (.state // "-"), (.tmux // "-"), (.where // "-"),
                      (.title // ""), .origin, (.running|tostring)])
      | map(if . == null or . == "" then "-" else . end) | @tsv' 2>/dev/null)
else
  while IFS='|' read -r tname twin tatt tpath; do
    [ -n "$tname" ] || continue
    T_N+=("$tname"); T_W[$tname]=$twin; T_A[$tname]=$((tatt > 0)); T_P[$tname]=$tpath
  done < <(tmux ls -F '#{session_name}|#{session_windows}|#{session_attached}|#{session_path}' 2>/dev/null)
  for t in "${T_N[@]}"; do T_A[$t]=$([ "${T_A[$t]}" = 1 ] && echo true || echo false); done
fi
# Docker: one `docker ps` (~90 ms; 2 s cap if the daemon hangs). Memory from
# cgroup v2 (memory.current of the container's scope) -- `docker stats` would
# take seconds. kind clusters are the containers labelled
# io.x-k8s.kind.cluster.
D_NAME=(); D_STATE=(); D_CL=(); D_ROLE=(); D_FOR=(); D_PORTS=(); D_MEM=()
if command -v docker >/dev/null 2>&1; then
  while IFS=$'\t' read -r did dname dstate dcl drole dfor dports; do
    [ -n "$did" ] || continue
    m=0; read -r m 2>/dev/null </sys/fs/cgroup/system.slice/docker-$did.scope/memory.current || m=0
    [ "$dcl" = "-" ] && dcl=""; [ "$drole" = "-" ] && drole=""; [ "$dports" = "-" ] && dports=""
    D_NAME+=("$dname"); D_STATE+=("$dstate"); D_CL+=("$dcl"); D_ROLE+=("$drole"); D_FOR+=("$dfor"); D_PORTS+=("$dports"); D_MEM+=("${m:-0}")
  done < <(timeout 2 docker ps -a --no-trunc --format '{{.ID}}	{{.Names}}	{{.State}}	{{if .Label "io.x-k8s.kind.cluster"}}{{.Label "io.x-k8s.kind.cluster"}}{{else}}-{{end}}	{{if .Label "io.x-k8s.kind.role"}}{{.Label "io.x-k8s.kind.role"}}{{else}}-{{end}}	{{.RunningFor}}	{{if .Ports}}{{.Ports}}{{else}}-{{end}}' 2>/dev/null)
fi

# ---------------------------------------------------------------- blocks
# Each block appends its rows (at most W columns wide) to ROWS / ROWW.

b_facts() {
  local W=$1 i
  if [ "$pair_w" -le "$W" ]; then
    for ((i = 0; i < ${#L_K[@]}; i++)); do
      key "${L_K[i]}" $KW; seg "" "${L_V[i]}"; padto $(( KW + lw + 4 ))
      key "${R_K[i]}" $(( KW + lw + 4 + 12 )); fit "${R_V[i]}" $(( W - RW )); seg "" "$FIT"; emit
    done
  else
    for ((i = 0; i < ${#L_K[@]}; i++)); do
      key "${L_K[i]}" 11; fit "${L_V[i]}" $(( W - 11 )); seg "" "$FIT"; emit
      key "${R_K[i]}" 11; fit "${R_V[i]}" $(( W - 11 )); seg "" "$FIT"; emit
    done
  fi
}

# CHECK on one line: "✓ gh  ✓ git  ✓ sops  ✓ kube <context>"; a check that is
# not ok is in that line too and gets one extra row with its detail.
b_check() {
  local W=$1 l state check text s sc bad=()
  [ ${#CHK[@]} -gt 0 ] || return 0
  key check $KW
  for l in "${CHK[@]}"; do
    IFS=$'\t' read -r state check text <<<"$l"
    case "$state" in ok) s="✓" sc=$G ;; bad) s="✗" sc=$C ;; *) s="!" sc=$YL ;; esac
    [ "$RW" -gt $KW ] && sp 2
    seg "$sc" "$s"; sp 1; seg "" "$check"
    if [ "$state" = ok ] && [ "$check" = kube ]; then fit "$text" $(( W - RW - 1 )); sp 1; seg "$dim" "$FIT"; fi
    [ "$state" = ok ] || bad+=("$l")
  done
  emit
  for l in "${bad[@]}"; do
    IFS=$'\t' read -r state check text <<<"$l"
    case "$state" in bad) s="✗" sc=$C ;; *) s="!" sc=$YL ;; esac
    key "" $KW; seg "$sc" "$s"; sp 1; seg "" "$check"; padto $(( KW + 8 ))
    fit "$text" $(( W - RW )); seg "" "$FIT"; emit
  done
}

# SYSTEM: one row per metric -- a horizontal bar (eighth blocks, the theme's
# gradient; yellow from 80 %, red from 90 %), the value, then the detail.
PART=("" "▏" "▎" "▍" "▌" "▋" "▊" "▉")
BW=12
b_system() {
  local W=$1 g p lvl i c k=system cell pc
  for ((g = 0; g < ${#G_P[@]}; g++)); do
    p=${G_P[g]}; lvl=$(( p * BW * 8 / 100 ))
    key "$k" $KW; k=""; seg "$acc" "${G_L[g]}"; padto $(( KW + 6 ))
    for ((i = 0; i < BW; i++)); do
      if [ "$p" -ge 90 ]; then c=$C; elif [ "$p" -ge 80 ]; then c=$YL
      else fg c $(( r1 + (r2 - r1) * i / (BW - 1) )) $(( g1 + (g2 - g1) * i / (BW - 1) )) $(( b1 + (b2 - b1) * i / (BW - 1) )); fi
      if [ "$lvl" -ge $(( (i + 1) * 8 )) ]; then cell="█"
      elif [ "$lvl" -gt $(( i * 8 )) ]; then cell=${PART[lvl - i * 8]}
      else c=$dim; cell="░"; fi
      R+="${c}${cell}${n}"; RW=$((RW + 1))
    done
    pc=$acc2; [ "$p" -ge 80 ] && pc=$YL; [ "$p" -ge 90 ] && pc=$C
    printf -v x '%4s' "${p}%"; sp 1; seg "$pc" "$x"; sp 2
    fit "${G_T[g]}" $(( W - RW )); seg "$dim" "$FIT"; emit
  done
}

b_status() {
  local W=$1 t
  key status $KW
  if [ "$reboot" = 1 ] || [ "$failed" -gt 0 ]; then
    t="! "; [ "$reboot" = 1 ] && t+="reboot required · " || t+="no reboot · "
    t+="${failed} failed unit(s)"
    t+=" · ${upd} updates"; fit "$t" $(( W - KW )); seg "$YL" "$FIT"
  else
    fit "✓ no reboot · 0 failed units · ${upd} updates" $(( W - KW )); seg "$dim" "$FIT"
  fi
  emit
}

# software of one category, wrapped at W
b_cat() {
  local ckey=$1 W=$2 k=$1 c name ver ilen
  while read -r c name ver; do
    [ "$c" = "$ckey" ] || continue
    vw "$name $ver"; ilen=$VW
    if [ "$RW" -gt $KW ] && [ $(( RW + 3 + ilen )) -gt "$W" ]; then emit; fi
    if [ "$RW" -eq 0 ]; then key "$k" $KW; k=""; else seg "$dim" " · "; fi
    seg "" "$name "; seg "$acc2" "$ver"
  done <"$VCACHE"
  [ "$RW" -gt 0 ] && emit
  return 0
}

# claude row: state symbol + word, title, [dir], age, "agent" when an agent
# started it. idle = waits for you, waiting = needs your approval.
# TMUX: one row per tmux session (attached first) --
#   ▣ <name>  <n> win  [attached]  <cwd>          "(kein Claude)" at the end
# and below it, indented, each Claude session running in one of its panes:
#   ✦ <state> <title> <age>     ◆ waiting yellow · ● busy green · ○ idle grey
# Only real tmux sessions; Claude running OUTSIDE tmux (a bare terminal, an
# agent) is in the CLAUDE block. ▣ and tmux names in one colour (acc), ✦ and
# Claude titles in the other (acc2). Columns aligned across the block; only
# titles are cut (word boundary, …, by characters).
cstate() {   # cstate state -> CS_SYM CS_COL CS_WORD
  case "$1" in
    waiting) CS_SYM="◆" CS_COL=$YL CS_WORD=waiting ;;
    idle)    CS_SYM="○" CS_COL=$dim CS_WORD=idle ;;
    *)       CS_SYM="●" CS_COL=$G CS_WORD=busy ;;
  esac
}
b_tmux() {
  local W=$1 t i k=tmux nw=0 ww=0 aw=0 tw sw=0 agw=0 ind=4 x
  local -a order=()
  [ ${#T_N[@]} -gt 0 ] || return 0
  # attached first, then by name
  for t in "${T_N[@]}"; do [ "${T_A[$t]}" = true ] && order+=("$t"); done
  for t in "${T_N[@]}"; do [ "${T_A[$t]}" = true ] || order+=("$t"); done
  # column widths
  for t in "${order[@]}"; do vw "$t"; [ "$VW" -gt "$nw" ] && nw=$VW; x="${T_W[$t]} win"; [ ${#x} -gt "$ww" ] && ww=${#x}; done
  for t in "${order[@]}"; do [ "${T_A[$t]}" = true ] && aw=8; done
  local tmax=0 ew=0 e
  for ((i = 0; i < ${#C_ST[@]}; i++)); do
    [ "${C_RUN[i]}" = true ] && [ "${C_TMUX[i]}" != "-" ] || continue
    e=0; [ "${C_OR[i]}" = agent ] && e=7
    case "${C_WH[i]}" in pts/*|background) e=$(( e + 2 + ${#C_WH[i]} )) ;; esac
    [ "$e" -gt "$ew" ] && ew=$e
    cstate "${C_ST[i]}"; [ ${#CS_WORD} -gt "$sw" ] && sw=${#CS_WORD}
    [ ${#C_AGE[i]} -gt "$agw" ] && agw=${#C_AGE[i]}
    vw "${C_TI[i]:-(ohne Titel)}"; [ "$VW" -gt "$tmax" ] && tmax=$VW
  done
  # KW, indent, "✦ ", "◆ " + word, gap, title, gap, age, extras
  tw=$(( W - KW - ind - 2 - 2 - sw - 2 - 2 - agw - ew )); [ "$tw" -gt "$tmax" ] && tw=$tmax; [ "$tw" -lt 8 ] && tw=8
  trow() {   # trow NAME WINS ATTACHED PATH HASCLAUDE
    local s0 p
    key "$k" $KW; k=""
    seg "$acc" "▣"; sp 1; s0=$RW; seg "$acc" "$1"; padto $(( s0 + nw ))
    if [ -n "$2" ]; then
      sp 2; s0=$RW; seg "$dim" "$2"; padto $(( s0 + ww ))
      [ "$aw" -gt 0 ] && { sp 2; s0=$RW; [ "$3" = true ] && seg "$G" "attached"; padto $(( s0 + aw )); }
      p=$4; [ "$p" = "$HOME" ] && p="~" || p=${p/#$HOME\//\~/}
      sp 2; fit "$p" $(( W - RW - ( $5 ? 0 : 15 ) )); seg "$dim" "$FIT"
      [ "$5" = 0 ] && { sp 2; seg "$dim" "(kein Claude)"; }
    fi
    emit
  }
  crun() {   # crun i
    local i=$1 fw s0
    cstate "${C_ST[i]}"
    key "" $KW; sp "$ind"
    seg "$acc2" "✦"; sp 1; s0=$RW; seg "$CS_COL" "$CS_SYM $CS_WORD"; padto $(( s0 + 2 + sw )); sp 2
    fit "${C_TI[i]:-(ohne Titel)}" "$tw"; vw "$FIT"; fw=$VW; seg "$acc2" "$FIT"; sp $(( tw - fw + 2 ))
    printf -v x "%${agw}s" "${C_AGE[i]}"; seg "$dim" "$x"
    [ "${C_OR[i]}" = agent ] && { sp 2; seg "$dim" "agent"; }
    case "${C_WH[i]}" in pts/*|background) sp 2; seg "$dim" "${C_WH[i]}" ;; esac
    emit
  }
  for t in "${order[@]}"; do
    local has=0
    for ((i = 0; i < ${#C_ST[@]}; i++)); do [ "${C_TMUX[i]}" = "$t" ] && [ "${C_RUN[i]}" = true ] && has=1; done
    [ -n "${T_KNOWN[$t]:-}" ] || has=1   # without claude-sessions: unknown, say nothing
    trow "$t" "${T_W[$t]} win" "${T_A[$t]}" "${T_P[$t]}" "$has"
    for ((i = 0; i < ${#C_ST[@]}; i++)); do [ "${C_TMUX[i]}" = "$t" ] && [ "${C_RUN[i]}" = true ] && crun "$i"; done
  done
}

# CLAUDE: first the conversations RUNNING outside tmux (a bare terminal, an
# agent) with their state and where; then, under a small grey "resume", the
# ones not running that you started (agents' runs are not yours to resume),
# newest first, at most 4, then "+N weitere (t cl)". Every row:
#   ✦ [state] <title> <cwd> <age> <where | id>
b_claude() {
  local W=$1 i r=0 cw=0 agw=0 sw=0 lw=0 tw tmax=0 fw s0 p rk
  local -a run=() res=() rows=()
  for ((i = 0; i < ${#C_ST[@]}; i++)); do
    if [ "${C_RUN[i]}" = true ]; then
      [ "${C_TMUX[i]}" = "-" ] || continue
      case "${C_ST[i]}" in waiting) rk=0 ;; busy) rk=1 ;; *) rk=2 ;; esac
      run+=("$rk $i")
    elif [ "${C_OR[i]}" = you ]; then res+=("$i"); fi
  done
  [ ${#run[@]} -gt 0 ] && mapfile -t run < <(printf '%s\n' "${run[@]}" | sort -n -s -k1,1 | awk '{print $2}')
  local nres=$(( ${#res[@]} > 4 ? 4 : ${#res[@]} ))
  rows=("${run[@]}" "${res[@]:0:nres}")
  [ ${#rows[@]} -gt 0 ] || return 0
  CPATH=(); CLAST=()
  for i in "${rows[@]}"; do
    p=${C_CWD[i]}; [ "$p" = "$HOME" ] && p="~" || p=${p/#$HOME\//\~/}; CPATH[i]=$p
    vw "$p"; [ "$VW" -gt "$cw" ] && cw=$VW
    [ ${#C_AGE[i]} -gt "$agw" ] && agw=${#C_AGE[i]}
    vw "${C_TI[i]:-(ohne Titel)}"; [ "$VW" -gt "$tmax" ] && tmax=$VW
    if [ "${C_RUN[i]}" = true ]; then
      cstate "${C_ST[i]}"; [ $(( 2 + ${#CS_WORD} )) -gt "$sw" ] && sw=$(( 2 + ${#CS_WORD} ))
      CLAST[i]=${C_WH[i]}; [ "${C_OR[i]}" = agent ] && CLAST[i]="agent · ${C_WH[i]}"
    else CLAST[i]=${C_ID[i]:0:8}; fi
    vw "${CLAST[i]}"; [ "$VW" -gt "$lw" ] && lw=$VW
  done
  local sg=0; [ "$sw" -gt 0 ] && sg=$(( sw + 2 ))
  tw=$(( W - KW - 2 - sg - 2 - cw - 2 - agw - 2 - lw )); [ "$tw" -gt "$tmax" ] && tw=$tmax
  if [ "$tw" -lt 20 ]; then local cut=$(( 20 - tw )); [ $(( cw - cut )) -lt 10 ] && cut=$(( cw - 10 )); [ "$cut" -gt 0 ] && { cw=$(( cw - cut )); tw=$(( tw + cut )); }; fi
  [ "$tw" -lt 8 ] && tw=8
  local first_res=${#run[@]} labelled=0
  for ((r = 0; r < ${#rows[@]}; r++)); do i=${rows[r]}
    # key column: CLAUDE on the first row; a small grey "resume" on the first
    # resume row (or the one after it, when CLAUDE took that row)
    if [ "$r" = 0 ]; then key claude $KW
    elif [ "$labelled" = 0 ] && [ "$r" -ge "$first_res" ]; then seg "$dim" "resume"; padto $KW; labelled=1
    else key "" $KW; fi
    [ "$r" = 0 ] && [ "$first_res" = 0 ] && labelled=0
    seg "$acc2" "✦"; sp 1
    if [ "$sg" -gt 0 ]; then
      s0=$RW
      if [ "${C_RUN[i]}" = true ]; then cstate "${C_ST[i]}"; seg "$CS_COL" "$CS_SYM $CS_WORD"; fi
      padto $(( s0 + sw )); sp 2
    fi
    fit "${C_TI[i]:-(ohne Titel)}" "$tw"; vw "$FIT"; fw=$VW
    if [ "${C_RUN[i]}" = true ]; then seg "$acc2" "$FIT"; else seg "$acc2" "$FIT"; fi
    sp $(( tw - fw + 2 ))
    fit "${CPATH[i]}" "$cw"; s0=$RW; seg "$dim" "$FIT"; padto $(( s0 + cw )); sp 2
    printf -v x "%${agw}s" "${C_AGE[i]}"; seg "$dim" "$x"; sp 2
    seg "$dim" "${CLAST[i]}"
    emit
  done
  # the "resume" label still owed (only one resume row, right after CLAUDE)
  if [ ${#res[@]} -gt 4 ]; then
    if [ "$labelled" = 0 ] && [ "$first_res" -lt ${#rows[@]} ]; then seg "$dim" "resume"; padto $KW; labelled=1; else key "" $KW; fi
    seg "$dim" "+$(( ${#res[@]} - 4 )) weitere (t cl)"; emit
  elif [ "$labelled" = 0 ] && [ "$first_res" -lt ${#rows[@]} ] && [ "$first_res" = 0 ]; then
    seg "$dim" "resume"; emit
  fi
}

# "18 hours ago" / "About an hour ago" / "2 days ago" -> SHORT (18h / 1h / 2d)
since_short() {
  local a=$1 num u   # not `n`: that is the colour reset
  case "$a" in "About an hour"*|"an hour"*) SHORT=1h; return ;; "About a minute"*|"Less than"*) SHORT=1m; return ;; esac
  read -r num u _ <<<"$a"
  case "$u" in second*) SHORT=1m ;; minute*) SHORT="${num}m" ;; hour*) SHORT="${num}h" ;; day*) SHORT="${num}d" ;; week*) SHORT="${num}w" ;; month*) SHORT="${num}mo" ;; *) SHORT=$a ;; esac
}
human_bytes() {   # bytes -> HB (1.2G / 640M)
  local b=$1
  if [ "$b" -ge 1073741824 ]; then printf -v HB '%d.%dG' $(( b / 1073741824 )) $(( b * 10 / 1073741824 % 10 ))
  else HB="$(( b / 1048576 ))M"; fi
}
# KIND: one row per kind cluster on this VM --
#   ⎈ <name>  <n> nodes (1 cp · 3 worker)  up 18h  :80 :443  api 10.100.136.86:40759
# yellow "x/y nodes up" when a node is not running. From docker only (labels,
# state, published ports) -- no kubectl, so a dead API server cannot hang it.
b_kind() {
  local W=$1 k=kind i c nodes up cp wk ports api age p hp cport col
  local -A seen=()
  for ((i = 0; i < ${#D_CL[@]}; i++)); do
    c=${D_CL[i]}; [ -n "$c" ] && [ -z "${seen[$c]:-}" ] || continue; seen[$c]=1
    nodes=0 up=0 cp=0 wk=0 ports="" api="" age=""
    local j
    for ((j = 0; j < ${#D_CL[@]}; j++)); do
      [ "${D_CL[j]}" = "$c" ] || continue
      nodes=$((nodes + 1)); [ "${D_STATE[j]}" = running ] && up=$((up + 1))
      case "${D_ROLE[j]}" in control-plane) cp=$((cp + 1))
        since_short "${D_FOR[j]}"; age=$SHORT
        # published ports of the control plane: the API (-> 6443) and the rest
        IFS=',' read -ra pp <<<"${D_PORTS[j]}"
        for p in "${pp[@]}"; do
          p=${p# }; [[ $p == *"->"* ]] || continue
          hp=${p%%->*}; cport=${p#*->}; cport=${cport%%/*}
          if [ "$cport" = 6443 ]; then
            [[ $hp == 0.0.0.0:* || $hp == "[::]:"* ]] && { [ -z "$api" ] && api=":${hp##*:}"; } || api=$hp
          else
            [[ " $ports " == *" :${hp##*:} "* ]] || ports+="${ports:+ }:${hp##*:}"
          fi
        done ;;
        *) wk=$((wk + 1)) ;;
      esac
    done
    key "$k" $KW; k=""
    seg "$acc" "⎈"; sp 1; seg "$acc" "$c"; sp 2
    if [ "$up" -lt "$nodes" ]; then seg "$YL" "$up/$nodes nodes up"; else seg "" "$nodes nodes"; fi
    seg "$dim" " ($cp cp · $wk worker)"
    [ -n "$age" ] && { sp 2; seg "$dim" "up $age"; }
    [ -n "$ports" ] && { sp 2; fit "$ports" $(( W - RW - 2 )); seg "$dim" "$FIT"; }
    [ -n "$api" ] && [ $(( RW + 6 + ${#api} )) -le "$W" ] && { sp 2; seg "$dim" "api "; seg "" "$api"; }
    emit
  done
}
# DOCKER: how many containers run, and the three that use the most memory.
b_docker() {
  local W=$1 i cnt=0 r line item
  local -a top=()
  for ((i = 0; i < ${#D_NAME[@]}; i++)); do [ "${D_STATE[i]}" = running ] && { cnt=$((cnt + 1)); top+=("${D_MEM[i]} $i"); }; done
  [ "$cnt" -gt 0 ] || return 0
  mapfile -t top < <(printf '%s\n' "${top[@]}" | sort -rn | head -3)
  key docker $KW; seg "" "$cnt running"; seg "$dim" " · top RAM:"
  for r in "${top[@]}"; do
    i=${r#* }; human_bytes "${r%% *}"
    item="${D_NAME[i]} $HB"; vw "$item"
    [ $(( RW + 3 + VW )) -le "$W" ] || break
    [ "$r" = "${top[0]}" ] && sp 1 || seg "$dim" " · "
    seg "" "${D_NAME[i]}"; seg "$acc2" " $HB"
  done
  emit
}

# TASKS: the global Taskfile's handiest aliases, wrapped between items like the
# software rows (only where ~/Taskfile.yml exists).
TASK_ITEMS=("tasks|pick any task" "t ta|attach tmux" "t tp|tmux per project" "t tc|new tmux session"
            "t cr|resume Claude" "t cl|list Claude" "t crm|delete Claude sessions" "t kc|kubeconfig"
            "t gcl|clone repos" "t chezmoi:update|dotfiles" "t secrets:list|secrets")
b_tasks() {
  local W=$1 k=tasks it c d ilen
  [ -f "$HOME/Taskfile.yml" ] || return 0
  for it in "${TASK_ITEMS[@]}"; do
    c=${it%%|*} d=${it#*|}
    vw "$c $d"; ilen=$VW
    if [ "$RW" -gt $KW ] && [ $(( RW + 3 + ilen )) -gt "$W" ]; then emit; fi
    if [ "$RW" -eq 0 ]; then key "$k" $KW; k=""; else seg "$dim" " · "; fi
    seg "$acc2" "$c"; seg "$dim" " $d"
  done
  [ "$RW" -gt 0 ] && emit
  return 0
}

# build W BLOCK... -> ROWS/ROWW plus per block BS (start) BL (rows) BB (blank
# before it when it is not first in its column: not between two categories)
build() {
  local W=$1 b s prev=""; shift
  ROWS=(); ROWW=(); BS=(); BL=(); BB=(); BNAME=()
  for b in "$@"; do
    s=${#ROWS[@]}
    case "$b" in cat:*) b_cat "${b#cat:}" "$W" ;; *) "b_$b" "$W" ;; esac
    [ ${#ROWS[@]} -gt "$s" ] || continue
    BS+=("$s"); BL+=($(( ${#ROWS[@]} - s ))); BNAME+=("$b")
    # no blank line between two software categories, nor inside the
    # workplace group TMUX / KIND / DOCKER
    if [[ "$b" == cat:* && "$prev" == cat:* ]] || [[ " tmux kind docker " == *" $b "* && " tmux kind docker " == *" $prev "* ]]; then BB+=(0); else BB+=(1); fi
    prev=$b
  done
}
# column FROM TO -> COL/COLW: the rows of blocks FROM..TO-1 with blank lines
column() {
  local i j; COL=(); COLW=()
  for ((i = $1; i < $2; i++)); do
    [ "$i" -gt "$1" ] && [ "${BB[i]}" = 1 ] && { COL+=(""); COLW+=(0); }
    for ((j = BS[i]; j < BS[i] + BL[i]; j++)); do COL+=("${ROWS[j]}"); COLW+=("${ROWW[j]}"); done
  done
}
# height FROM TO -> H
height() { local i; H=0; for ((i = $1; i < $2; i++)); do H=$(( H + BL[i] )); [ "$i" -gt "$1" ] && H=$(( H + BB[i] )); done; }

CATKEYS=(SHELL); [ -r "$VCACHE" ] && for c in "${CATS[@]}"; do [ "${c%% *}" = SHELL ] || CATKEYS+=("${c%% *}"); done
CATB=(); [ -r "$VCACHE" ] && for c in "${CATKEYS[@]}"; do CATB+=("cat:$c"); done
MACHB=(facts system status)

gradient_rows() {   # print LINES (array name) with the art gradient, padded to $2
  local -n _l=$1; local r rows=${#_l[@]} line
  for ((r = 0; r < rows; r++)); do line=""; [ -n "${_l[r]}" ] && grad line "${_l[r]}" "$r" "$rows"; GR[r]=$line; done
}

# ---------------------------------------------------------------- layout
# >= 140: the mascot next to what the machine is and has (facts, SYSTEM,
#         STATUS, the software); below the rule, full width, what to act on:
#         CHECK, TMUX, CLAUDE, TASKS.
# 110-139: the wordmark, then two columns of equal width, split where both
#         end level. < 110: the wordmark (if it fits), one column.
if [ "$TOTAL" -ge 140 ]; then
  LEFT=("${ART[@]}" "" "${WORDMARK[@]}"); nl=${#LEFT[@]}
  LW=$ART_W; MW=$(( TOTAL - 1 - LW - 3 ))   # the right column: what is left
  build "$MW" "${MACHB[@]}" "${CATB[@]}"
  column 0 ${#BS[@]}; TOP=("${COL[@]}")
  off=$(( nl - ${#TOP[@]} )); [ $off -lt 0 ] && off=0; [ $off -gt 2 ] && off=2
  GR=(); gradient_rows LEFT
  total=$(( nl > ${#TOP[@]} + off ? nl : ${#TOP[@]} + off ))
  for ((r = 0; r < total; r++)); do
    a=${LEFT[r]:-}; pad=$(( LW - ${#a} ))
    pi=$(( r - off ))
    if [ $pi -ge 0 ] && [ $pi -lt ${#TOP[@]} ]; then
      printf ' %s%s%*s   %s\n' "${GR[r]:-}" "$n" "$pad" "" "${TOP[pi]}"
    else
      printf ' %s%s\n' "${GR[r]:-}" "$n"
    fi
  done
  # below the rule (exactly TOTAL wide, flush with the top), full width:
  # CHECK on one line, TMUX, CLAUDE, TASKS
  BWID=$(( TOTAL - 1 ))
  printf -v RULE '%*s' "$BWID" ''; printf ' %s%s%s\n' "$dim" "${RULE// /─}" "$n"
  build "$BWID" check tmux kind docker claude tasks
  column 0 ${#BS[@]}; for l in "${COL[@]}"; do printf ' %s\n' "$l"; done
elif [ "$TOTAL" -ge 110 ]; then
  GR=(); gradient_rows WORDMARK; for l in "${GR[@]}"; do printf ' %s%s\n' "$l" "$n"; done; echo
  CW_=$(( (TOTAL - 1 - 3) / 2 ))
  build "$CW_" "${MACHB[@]}" "${CATB[@]}"
  nb=${#BS[@]}; best=1; bd=99999
  for ((k = 1; k < nb; k++)); do
    height 0 "$k"; hl=$H; height "$k" "$nb"; d=$(( hl > H ? hl - H : H - hl ))
    [ "$d" -lt "$bd" ] && { bd=$d; best=$k; }
  done
  column 0 "$best"; LC=("${COL[@]}"); LCW=("${COLW[@]}")
  column "$best" "$nb"; RC=("${COL[@]}")
  total=$(( ${#LC[@]} > ${#RC[@]} ? ${#LC[@]} : ${#RC[@]} ))
  for ((r = 0; r < total; r++)); do
    if [ $r -lt ${#RC[@]} ]; then
      printf ' %s%*s   %s\n' "${LC[r]:-}" $(( CW_ - ${LCW[r]:-0} )) "" "${RC[r]}"
    else
      printf ' %s\n' "${LC[r]:-}"
    fi
  done
  # below both columns, full width: CHECK, TMUX, CLAUDE, TASKS
  echo; build $(( TOTAL - 1 )) check tmux kind docker claude tasks
  column 0 ${#BS[@]}; for l in "${COL[@]}"; do printf ' %s\n' "$l"; done
else
  if [ "$TOTAL" -ge 62 ]; then GR=(); gradient_rows WORDMARK; for l in "${GR[@]}"; do printf ' %s%s\n' "$l" "$n"; done; echo; fi
  build $(( TOTAL - 1 )) "${MACHB[@]}" "${CATB[@]}" check tmux kind docker claude tasks
  column 0 ${#BS[@]}; for l in "${COL[@]}"; do printf ' %s\n' "$l"; done
fi
echo
